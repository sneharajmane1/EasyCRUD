pipeline {
    agent {
        lable 'worker'
    }

    stages {

        stage('Checkout') {
            steps {
                git branch: 'main',
                    url: 'https://github.com/sneharajmane1/EasyCRUD.git'
            }
        }

        stage('Backend Build') {
            steps {
                dir('backend') {
                    sh './mvnw clean package -DskipTests'
                }
            }
        }

    }
}